# Copy to .env (never committed) and fill in. Read by ultraq (python-dotenv, .env at or above the cwd).
# IQM Resonance server
IQM_URL=
# Token for fetching calibration data
IQM_CALIBRATION_TOKEN=
# Token for running circuits (name imposed by iqm-client, which reads it itself)
IQM_TOKEN=
# ultraq log level: DEBUG, INFO, WARNING or ERROR (default INFO)
ULTRAQ_LOG_LEVEL=INFO
